# Copy this file to  android/keystore.properties  and fill in your real values.
# android/keystore.properties is gitignored — it holds passwords, never commit it.
#
# storeFile is resolved relative to the android/ project folder, so "../upload-keystore.jks"
# points at the keystore in the repo root (D:\claude_working\upload-keystore.jks).
storeFile=../upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
