{
  "name": "cultivator-idle",
  "version": "0.1.0",
  "description": "Desktop wuxia cultivation idle game - a cultivator lives on the side of your screen",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "dist": "npx electron-packager . \"Cultivator Idle\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"(\\.git|3d[\\\\/])\"",
    "dist:mac": "npx electron-packager . \"Cultivator Idle\" --platform=darwin --arch=x64,arm64 --out=dist --overwrite --ignore=\"(\\.git|3d[\\\\/])\"",
    "build:web": "node scripts/build-ios-web.js",
    "cap:sync": "npm run build:web && npx cap sync ios",
    "ios:open": "npm run cap:sync && npx cap open ios",
    "cap:sync:android": "npm run build:web && npx cap sync android",
    "android:open": "npm run cap:sync:android && npx cap open android",
    "android:bundle": "cd android && gradlew.bat bundleRelease",
    "release:android": "node scripts/release-android.js",
    "test": "node scripts/check-syntax.js && node scripts/check-no-chrome-cjk.js --strict && node scripts/check-no-emoji.js --strict",
    "sim": "node scripts/sim/run.js",
    "sim:quick": "node scripts/sim/run.js --profiles=active,afk --hours=24 --seeds=1 --out=scripts/sim/out/quick",
    "checks": "node scripts/sim/checks/run-all.js",
    "export:data": "node scripts/export-sim-data.js",
    "export:data:check": "node scripts/export-sim-data.js --check",
    "release": "node scripts/release.js"
  },
  "author": "Cultivator Idle",
  "keywords": [
    "idle-game",
    "wuxia",
    "cultivation",
    "electron",
    "desktop"
  ],
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "git": "^0.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "electron": "^28.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cultivator.idle",
    "productName": "Cultivator Idle",
    "copyright": "Cultivator Idle",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
